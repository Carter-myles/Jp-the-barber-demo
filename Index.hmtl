<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JP The Barber | Rockford, IL</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #0b0b0b;
      color: #fff;
      line-height: 1.6;
    }

    header {
      min-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px 20px;
      background:
        radial-gradient(circle at top, #333 0%, #111 45%, #050505 100%);
    }

    .hero {
      max-width: 700px;
    }

    .tag {
      color: #aaa;
      text-transform: uppercase;
      letter-spacing: 4px;
      font-size: 13px;
      margin-bottom: 15px;
    }

    h1 {
      font-size: clamp(48px, 13vw, 90px);
      line-height: 0.95;
      margin-bottom: 20px;
    }

    .hero p {
      color: #ccc;
      font-size: 18px;
      margin-bottom: 30px;
    }

    .button {
      display: inline-block;
      background: #fff;
      color: #000;
      padding: 14px 25px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.2s;
    }

    .button:hover {
      transform: translateY(-2px);
      background: #ddd;
    }

    section {
      padding: 70px 20px;
      max-width: 1000px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      font-size: 36px;
      margin-bottom: 40px;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .service {
      background: #171717;
      border: 1px solid #292929;
      border-radius: 15px;
      padding: 25px;
    }

    .service h3 {
      margin-bottom: 8px;
    }

    .price {
      color: #aaa;
      font-size: 18px;
      font-weight: bold;
    }

    .about {
      background: #151515;
      max-width: none;
    }

    .about-content {
      max-width: 750px;
      margin: auto;
      text-align: center;
    }

    .about-content p {
      color: #bbb;
      font-size: 17px;
    }

    .contact {
      text-align: center;
    }

    .contact p {
      color: #bbb;
      margin-bottom: 25px;
    }

    footer {
      text-align: center;
      padding: 30px 20px;
      border-top: 1px solid #222;
      color: #777;
      font-size: 14px;
    }

    @media (max-width: 500px) {
      section {
        padding: 55px 18px;
      }

      .section-title {
        font-size: 30px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="hero">
      <div class="tag">Rockford, Illinois</div>

      <h1>JP<br>THE BARBER</h1>

      <p>
        Clean cuts. Sharp fades. Fresh confidence.
      </p>

      <a href="#services" class="button">View Services</a>
    </div>
  </header>


  <section id="services">
    <h2 class="section-title">Services</h2>

    <div class="services">

      <div class="service">
        <h3>Haircut</h3>
        <p>Clean, personalized cut.</p>
        <div class="price">$30</div>
      </div>

      <div class="service">
        <h3>Fade</h3>
        <p>Sharp fade with detailed finishing.</p>
        <div class="price">$35</div>
      </div>

      <div class="service">
        <h3>Haircut + Beard</h3>
        <p>Full haircut with beard cleanup.</p>
        <div class="price">$45</div>
      </div>

      <div class="service">
        <h3>Beard Trim</h3>
        <p>Clean lines and professional shaping.</p>
        <div class="price">$20</div>
      </div>

    </div>
  </section>


  <div class="about">
    <section>
      <div class="about-content">

        <h2 class="section-title">About JP</h2>

        <p>
          JP The Barber is a local Rockford barber focused on
          clean cuts, detailed fades, and making every client
          leave looking fresh.
        </p>

      </div>
    </section>
  </div>


  <section class="contact">
    <h2 class="section-title">Book Your Cut</h2>

    <p>
      Ready for a fresh cut? Get in touch with JP The Barber
      to schedule your appointment.
    </p>

    <!-- Replace the # below with the REAL booking link
         after getting permission from the business. -->

    <a href="#" class="button">Book Appointment</a>
  </section>


  <footer>
    © 2026 JP The Barber · Rockford, IL
  </footer>

</body>
</html>
